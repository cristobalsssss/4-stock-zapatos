        "jsCode": "const calc = $('Calcular Reintegro').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    mensaje: 'Devolución registrada con éxito y stock reintegrado',\n    variante_id: calc.variante_id,\n    sku_variante: calc.sku_variante,\n    venta_id: calc.venta_id,\n    cantidad_reintegrada: calc.cantidad,\n    motivo: calc.motivo,\n    stock_anterior: calc.stock_actual,\n    stock_disponible: calc.nuevo_stock,\n    fecha: new Date().toISOString()\n  }\n}];"
