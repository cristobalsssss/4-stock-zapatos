      "parameters": {
        "jsCode": "// Extraer y validar los parámetros de devolución\nconst input = $input.first().json.body || $input.first().json;\n\nconst variante_id = input.variante_id;\nconst venta_id = input.venta_id || null;\nconst cantidad = Math.max(1, parseInt(input.cantidad, 10) || 1);\nconst motivo = (input.motivo || 'Devolución de cliente / Cambio').toString().trim();\n\nif (!variante_id) {\n  throw new Error('El campo variante_id es obligatorio');\n}\n\nreturn [{\n  json: {\n    variante_id,\n    venta_id,\n    cantidad,\n    motivo\n  }\n}];"
      },
