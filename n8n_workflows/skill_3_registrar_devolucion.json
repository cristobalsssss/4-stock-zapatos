    {
      "parameters": {
        "jsCode": "// Procesar cálculo de nuevo stock\nconst devData = $('Validar Datos Devolución').first().json;\nconst variante = $input.first() ? $input.first().json : null;\n\nif (!variante || !variante.id) {\n  return [{\n    json: {\n      valido: false,\n      error: 'Variante no encontrada en inventario',\n      status_code: 404\n    }\n  }];\n}\n\nconst stock_actual = parseInt(variante.stock_disponible, 10) || 0;\nconst nuevo_stock = stock_actual + devData.cantidad;\n\nreturn [{\n  json: {\n    valido: true,\n    variante_id: variante.id,\n    sku_variante: variante.sku_variante,\n    venta_id: devData.venta_id,\n    cantidad: devData.cantidad,\n    motivo: devData.motivo,\n    stock_actual,\n    nuevo_stock,\n    precio_aplicado: parseFloat(variante.precio_vendedores) || 0\n  }\n}];"
      },
