{
  "name": "Skill 2 - Registrar Venta",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "registrar-venta",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-registrar-venta",
      "name": "Webhook Registrar Venta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "webhook-registrar-venta"
    },
    {
      "parameters": {
        "jsCode": "// Extraer y validar los parámetros de la venta entrante\nconst input = $input.first().json.body || $input.first().json;\n\nconst variante_id = input.variante_id;\nconst cantidad = Math.max(1, parseInt(input.cantidad, 10) || 1);\nconst vendedor = (input.vendedor || 'admin').toString().trim();\nconst medio_pago = (input.medio_pago || 'Efectivo').toString().trim();\nconst precio_aplicado = parseFloat(input.precio_aplicado) || null;\nconst comision_vendedor = input.comision_vendedor !== undefined ? parseFloat(input.comision_vendedor) : null;\nconst notas = input.notas || 'Venta registrada desde n8n';\n\nif (!variante_id) {\n  throw new Error('El campo variante_id es obligatorio');\n}\n\nreturn [{\n  json: {\n    variante_id,\n    cantidad,\n    vendedor,\n    medio_pago,\n    precio_aplicado,\n    comision_vendedor,\n    notas\n  }\n}];"
      },
      "id": "code-validar-entrada",
      "name": "Validar Datos Entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://leifskqgupgsajgemgul.supabase.co/rest/v1/inventario_variantes?id=eq.{{ $json.variante_id }}&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "TU_SUPABASE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer TU_SUPABASE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "http-consultar-variante",
      "name": "Consultar Stock Variante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Verificar stock disponible vs cantidad solicitada\nconst ventaData = $('Validar Datos Entrada').first().json;\nconst variante = $input.first() ? $input.first().json : null;\n\nif (!variante || !variante.id) {\n  return [{\n    json: {\n      valido: false,\n      error: 'Variante no encontrada en la base de datos',\n      status_code: 404\n    }\n  }];\n}\n\nconst stock_actual = parseInt(variante.stock_disponible, 10) || 0;\nconst cantidad = ventaData.cantidad;\n\nif (stock_actual < cantidad) {\n  return [{\n    json: {\n      valido: false,\n      error: `Stock insuficiente. Disponible: ${stock_actual}, Solicitado: ${cantidad}`,\n      stock_disponible: stock_actual,\n      status_code: 400\n    }\n  }];\n}\n\nconst precio_final = ventaData.precio_aplicado !== null ? ventaData.precio_aplicado : parseFloat(variante.precio_vendedores);\nconst precio_interno = parseFloat(variante.precio_interno) || 0;\nlet comision = ventaData.comision_vendedor;\nif (comision === null) {\n  comision = Math.max(0, (precio_final - precio_interno) * cantidad);\n}\n\nconst nuevo_stock = stock_actual - cantidad;\nconst monto_total = precio_final * cantidad;\n\nreturn [{\n  json: {\n    valido: true,\n    variante_id: variante.id,\n    sku_variante: variante.sku_variante,\n    cantidad,\n    vendedor: ventaData.vendedor,\n    medio_pago: ventaData.medio_pago,\n    precio_aplicado: precio_final,\n    comision_vendedor: comision,\n    monto_total,\n    stock_actual,\n    nuevo_stock,\n    notas: ventaData.notas\n  }\n}];"
      },
      "id": "code-verificar-stock",
      "name": "Verificar Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "stock-valido",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
