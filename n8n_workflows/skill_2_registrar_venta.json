        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const vInfo = $('Verificar Stock').first().json;\nconst venta = $('Insertar Venta').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    mensaje: 'Venta registrada con éxito y stock actualizado',\n    venta_id: venta.id,\n    variante_id: vInfo.variante_id,\n    sku_variante: vInfo.sku_variante,\n    vendedor: vInfo.vendedor,\n    cantidad_vendida: vInfo.cantidad,\n    precio_unitario: vInfo.precio_aplicado,\n    monto_total: vInfo.monto_total,\n    comision_vendedor: vInfo.comision_vendedor,\n    stock_anterior: vInfo.stock_actual,\n    stock_restante: vInfo.nuevo_stock,\n    fecha: venta.fecha_venta || new Date().toISOString()\n  }\n}];"
      },
